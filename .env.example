# Copy to .env before `make dev`. .env is gitignored; this file is committed.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432

# Host-side tooling (make migrate, pytest) talks to the published port. The API
# container gets its own DATABASE_URL from docker-compose.yml, pointing at the
# `postgres` service name instead.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- API --------------------------------------------------------------------
API_PORT=8000
LOG_LEVEL=INFO

# --- Generation -------------------------------------------------------------
# Only POST /query, GET /query/stream, the golden-set builder and the judge need a
# model. Everything else — ingestion, retrieval, reranking, refusal, the ablation
# matrix and the entire test suite — runs without one. Never commit a real value.
#
# Two providers are supported. Pick one.
#
# 1. Anthropic (paid).
ANTHROPIC_API_KEY=

# 2. Any OpenAI-compatible endpoint (Groq, Cerebras, OpenRouter, or a local Ollama).
#    Groq's free tier needs no card: 30 requests/minute, 1,000/day.
#    Get a key at console.groq.com, then set GenerationConfig(provider=
#    "openai_compatible", base_url=..., model="llama-3.3-70b-versatile").
#
#    For a local Ollama server, leave this blank — it needs no credential.
LLM_API_KEY=
